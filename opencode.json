{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "railway": {
      "type": "remote",
      "url": "https://mcp.railway.com"
    },
    "render": {
      "type": "remote",
      "url": "https://mcp.render.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:RENDER_API_KEY}"
      }
    }
  }
}